{
  "name": "slop-video-compositor",
  "version": "0.3.0",
  "description": "Desktop hard-cut video compositor: multi-track timeline, filmstrips, audio beds, reframe, export H.264+AAC MP4",
  "type": "module",
  "author": "Meigo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meigo/slop-video-compositor.git"
  },
  "bugs": {
    "url": "https://github.com/meigo/slop-video-compositor/issues"
  },
  "homepage": "https://github.com/meigo/slop-video-compositor#readme",
  "keywords": [
    "tauri",
    "svelte",
    "sveltekit",
    "typescript",
    "rust",
    "ffmpeg",
    "video-editor",
    "video-compositor",
    "desktop-app",
    "macos",
    "hard-cut",
    "nle",
    "animation"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@lucide/svelte": "^1.27.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
